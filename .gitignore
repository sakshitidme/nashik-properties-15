# ======================================================
# Nashik Property 15 — .gitignore
# ======================================================

# ── Dependencies ──────────────────────────────────────
node_modules/
server/node_modules/

# ── Build output ──────────────────────────────────────
dist/
dist-ssr/
build/

# ── Environment files — NEVER commit real env files ───
.env
.env.*
*.local
server/.env
server/.env.*

# ── Logs ─────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS / Editor ───────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Secrets & keys (belt-and-suspenders) ─────────────
*.pem
*.key
*.cert
*.p12
serviceAccountKey.json
